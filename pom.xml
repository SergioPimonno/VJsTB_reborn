<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.vjstb</groupId>
    <artifactId>led-scheme</artifactId>
    <version>2.0.0</version>
    <packaging>jar</packaging>

    <name>led-scheme</name>
    <description>
        Настольное приложение (Java/Swing) для проектирования схем коммутации
        LED-экранов и видеосопровождения: проекты -&gt; сцены -&gt; экраны -&gt;
        LED cabinets, библиотека кабинетов, схемы расключения питания и сигнала.
        Весь интерфейс — внутри приложения; данные хранятся локально (JSON).
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <jackson.version>2.17.2</jackson.version>
        <flatlaf.version>3.5.1</flatlaf.version>
        <junit.version>5.10.3</junit.version>
        <poi.version>5.2.5</poi.version>
        <jogl.version>2.6.0</jogl.version>
        <main.class>com.vjstb.ledscheme.App</main.class>
    </properties>

    <dependencies>
        <!-- Экспорт спецификации в .xlsx (ui.stage.OutputStagePanel / service.SpecXlsxWriter) -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>

        <!-- Общие доменные POJO для видов общей библиотеки (см. ledscheme-model) —
             нужно один раз собрать `mvn install` в этом соседнем проекте перед
             сборкой этого. -->
        <dependency>
            <groupId>com.vjstb.ledscheme</groupId>
            <artifactId>ledscheme-model</artifactId>
            <version>0.1.0</version>
        </dependency>

        <!-- JSON-хранение проектов и библиотеки -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- Современная тёмная тема для Swing -->
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
            <version>${flatlaf.version}</version>
        </dependency>

        <!-- Тесты доменной логики (без UI) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- 3D-превью наземного конструктива (ui.Structure3DPanel, см. STRUCTURE_CALC_NOTES.md) —
             GLJPanel встраивается в Swing-layout как обычный компонент (в отличие от LWJGL,
             у которого своё нативное окно). Windows + macOS нативы упакованы — Linux всё ещё
             не подключён (CI под Linux, см. CLAUDE.md секция 4, соберёт клиент, но 3D
             откажет с дружелюбным сообщением при попытке открыть, см. Structure3DPanel:
             инициализация GL ленивая и обёрнута в try/catch, не крашем всё приложение). При
             необходимости Linux добавляется тем же приёмом — natives-linux-amd64. -->
        <dependency>
            <groupId>org.jogamp.gluegen</groupId>
            <artifactId>gluegen-rt</artifactId>
            <version>${jogl.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jogamp.gluegen</groupId>
            <artifactId>gluegen-rt</artifactId>
            <version>${jogl.version}</version>
            <classifier>natives-windows-amd64</classifier>
        </dependency>
        <dependency>
            <groupId>org.jogamp.gluegen</groupId>
            <artifactId>gluegen-rt</artifactId>
            <version>${jogl.version}</version>
            <classifier>natives-macosx-universal</classifier>
        </dependency>
        <dependency>
            <groupId>org.jogamp.jogl</groupId>
            <artifactId>jogl-all</artifactId>
            <version>${jogl.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jogamp.jogl</groupId>
            <artifactId>jogl-all</artifactId>
            <version>${jogl.version}</version>
            <classifier>natives-windows-amd64</classifier>
        </dependency>
        <dependency>
            <groupId>org.jogamp.jogl</groupId>
            <artifactId>jogl-all</artifactId>
            <version>${jogl.version}</version>
            <classifier>natives-macosx-universal</classifier>
        </dependency>
    </dependencies>

    <build>
        <finalName>led-scheme</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <!-- Самодостаточный исполняемый jar со всеми зависимостями -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer
                                    implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
